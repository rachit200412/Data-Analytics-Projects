calculate_correlation <- function(data, trial_store, metric) {
  
  trial_data <- data %>%
    filter(STORE_NBR == trial_store) %>%
    select(MONTH, TRIAL = all_of(metric))
  
  data %>%
    filter(STORE_NBR != trial_store) %>%
    select(STORE_NBR, MONTH, VALUE = all_of(metric)) %>%
    left_join(trial_data, by = "MONTH") %>%
    group_by(STORE_NBR) %>%
    summarise(
      CORRELATION = cor(TRIAL, VALUE),
      .groups = "drop"
    ) %>%
    arrange(desc(CORRELATION))
}

