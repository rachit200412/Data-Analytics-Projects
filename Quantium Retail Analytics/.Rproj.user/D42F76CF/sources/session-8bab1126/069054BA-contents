calculate_magnitude <- function(data, trial_store, metric) {
  
  trial_data <- data %>%
    filter(STORE_NBR == trial_store) %>%
    select(MONTH, TRIAL = all_of(metric))
  
  data %>%
    filter(STORE_NBR != trial_store) %>%
    select(STORE_NBR, MONTH, VALUE = all_of(metric)) %>%
    left_join(trial_data, by = "MONTH") %>%
    mutate(
      DIFF = abs(TRIAL - VALUE)
    ) %>%
    group_by(STORE_NBR) %>%
    summarise(
      MAGNITUDE = mean(DIFF),
      .groups = "drop"
    ) %>%
    arrange(MAGNITUDE)
}


